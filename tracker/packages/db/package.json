{
  "name": "@tracker/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "comment": "DATABASE_URL is inlined so a fresh clone needs no .env. It is a relative SQLite path, not a secret. Override the env var to point elsewhere (e.g. Postgres).",
  "scripts": {
    "push": "DATABASE_URL=${DATABASE_URL:-file:../../../tracker.db} prisma db push",
    "generate": "DATABASE_URL=${DATABASE_URL:-file:../../../tracker.db} prisma generate",
    "studio": "DATABASE_URL=${DATABASE_URL:-file:../../../tracker.db} prisma studio"
  },
  "dependencies": { "@prisma/client": "^6.1.0" },
  "devDependencies": { "prisma": "^6.1.0" }
}
