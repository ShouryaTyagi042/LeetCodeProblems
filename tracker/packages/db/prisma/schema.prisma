// DSA Practice Tracker — data model (AlgoZenith/WEBAPP_PLAN.md §5)
//
// SQLite for local single-user use. To move to Postgres later, change
// `provider` to "postgresql" and point DATABASE_URL at the server; no
// model changes are needed (nothing here uses SQLite-specific types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Problem {
  id            String    @id @default(cuid())
  slug          String    @unique // 'graphs/dijkstras'
  title         String
  folderPath    String    @unique // 'topics/Graphs/Dijkstras' — the sync key
  source        String? // AlgoZenith | LeetCode | CSES | AtCoder | Codeforces
  judgeUrl      String?
  difficulty    String? // Easy | Medium | Hard
  // Sortable rank for difficulty: ordering the string alphabetically gives
  // Easy < Hard < Medium. Kept in step with `difficulty` on every write.
  difficultyRank Int?
  firstSolvedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  topics    ProblemTopic[]
  patterns  ProblemPattern[]
  solutions Solution[]
  testcases Testcase[]
  note      Note?
  card      Card?
  reviews   Review[]

  @@index([difficulty])
  @@index([difficultyRank])
  @@index([createdAt])
  @@index([source])
}

model Topic {
  id       String         @id @default(cuid())
  name     String         @unique // 'Two Pointers'
  slug     String         @unique // 'two-pointers'
  problems ProblemTopic[]
  revision TopicRevision?
}

// Topic-level revision, separate from per-problem scheduling.
//
// Deliberately a fixed ladder (3d, 1w, 2w, 1mo) rather than FSRS: FSRS
// models recall of one specific item, whereas sweeping a whole topic is a
// different activity with no single right/wrong answer to fit a model to.
model TopicRevision {
  topicId        String    @id
  due            DateTime
  step           Int       @default(0) // index into TOPIC_LADDER_DAYS
  reps           Int       @default(0)
  lastReviewedAt DateTime?
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([due])
}

model Pattern {
  id       String           @id @default(cuid())
  name     String           @unique // '0-1 BFS'
  slug     String           @unique
  problems ProblemPattern[]
}

model ProblemTopic {
  problemId String
  topicId   String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([problemId, topicId])
  @@index([topicId])
}

model ProblemPattern {
  problemId String
  patternId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
  @@index([patternId])
}

model Solution {
  id        String   @id @default(cuid())
  problemId String
  language  String   @default("java")
  code      String
  filePath  String // relative to the AlgoZenith root
  loc       Int      @default(0)
  syncedAt  DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, filePath])
}

model Testcase {
  id        String  @id @default(cuid())
  problemId String
  input     String
  expected  String
  ord       Int     @default(0)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, ord])
}

model Note {
  problemId String   @id
  framework String? // the approach, in your words
  notes     String?
  mistakes  String? // what you got wrong
  updatedAt DateTime @updatedAt
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

// Current scheduling state, one row per reviewable problem (Phase 3).
// Split from Review the way Anki splits cards from its revlog: Review is
// the append-only history, Card is the single mutable "where does this
// stand now" row, which is what makes "what is due?" one indexed query.
model Card {
  problemId     String    @id
  due           DateTime
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         String    @default("new") // new | learning | review | relearning
  lastReview    DateTime?
  suspended     Boolean   @default(false)
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([due])
  @@index([state])
  @@index([suspended])
}

// Append-only review history. Every graded review appends one row holding
// the card state that review produced, so the log alone can rebuild or
// audit any schedule. Seeded from Notion's `Due At` so scheduling does
// not restart from zero.
model Review {
  id            String    @id @default(cuid())
  problemId     String
  reviewedAt    DateTime  @default(now())
  rating        Int? // 1=again 2=hard 3=good 4=easy
  state         String? // card state AFTER this review
  stability     Float?
  difficulty    Float?
  elapsedDays   Int?
  scheduledDays Int?
  dueAt         DateTime?
  durationMs    Int?
  seeded        Boolean   @default(false) // true for rows imported from Notion
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([dueAt])
  @@index([reviewedAt])
}
